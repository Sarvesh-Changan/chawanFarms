NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=verify-full
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/DB?sslmode=verify-full
AUTH_SECRET=replace-with-openssl-rand-base64-32-output
PREVIEW_SECRET=replace-with-independent-preview-secret-at-least-32-characters
CRON_SECRET=replace-with-independent-cron-secret-at-least-32-characters
AUTH_TRUSTED_ORIGINS=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-account
SMTP_PASS=replace-with-smtp-app-password
EMAIL_FROM=replace-with-smtp-account
EMAIL_FROM_NAME=replace-with-sender-name
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=replace-with-admin-email
EMAIL_DAILY_LIMIT=400
EMAIL_TRANSACTIONAL_RESERVE_PERCENT=25
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET_CUSTOMER_VIDEO=chawan-customer-video
CLOUDINARY_UPLOAD_PRESET_ADMIN_IMAGE=chawan-admin-image
CLOUDINARY_UPLOAD_PRESET_ADMIN_VIDEO=chawan-admin-video
CLOUDINARY_FOLDER_MODE=dynamic
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_TEST_MODE=0
